# WB CRM — переменные окружения (раздел 14 плана)
# Скопируйте в .env.local и заполните. Без ключей приложение работает в демо-режиме.
# (Файл .env.local уже создан в корне — заполняйте прямо там.)

# Supabase (БД + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # только сервер! обходит RLS
SUPABASE_DB_URL=                      # для миграций (npm run db:push / psql)

# Claude (ключ платформы; пользовательские ключи — в Vault)
ANTHROPIC_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OpenAI Whisper — распознавание голосовых для Telegram-бота (КП п.4.6), опционально
OPENAI_API_KEY=

# Прочее
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                          # защита cron-эндпоинтов синхронизации WB
